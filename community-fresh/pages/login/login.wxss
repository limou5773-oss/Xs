.container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
    background-color: #f8f8f8;
  }
  
  .login-btn {
    background-color: #07c160;
    color: #fff;
    font-size: 32rpx;
    padding: 20rpx 80rpx;
    border-radius: 12rpx;
    margin-top: 80rpx;
  }
  
  .user-info {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .avatar {
    width: 150rpx;
    height: 150rpx;
    border-radius: 50%;
    margin-top: 120rpx;
    margin-bottom: 20rpx;
  }
  
  .nickname {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 40rpx;
  }
  
  .logout-btn {
    background-color: #f44;
    color: #fff;
    font-size: 28rpx;
    padding: 18rpx 60rpx;
    border-radius: 10rpx;
  }
  