/* pages/category/category.wxss */
page {
    height: 100%;
    background-color: #fff;
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  }
  
  .container {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  
  .main-box {
    flex: 1;
    display: flex;
    height: 100%;
    overflow: hidden;
  }
  
  /* --- 左侧菜单 --- */
  .left-menu {
    width: 180rpx;
    background-color: #f5f5f5; /* 浅灰背景 */
    height: 100%;
  }
  
  .menu-item {
    height: 100rpx;
    display: flex; align-items: center; justify-content: center;
    font-size: 26rpx; color: #666; position: relative;
  }
  
  /* 选中态 */
  .menu-item.active {
    background-color: #fff;
    color: #333;
    font-weight: bold;
    font-size: 28rpx;
  }
  /* 选中时的绿色竖条 */
  .menu-item.active::before {
    content: ''; position: absolute; left: 0; top: 30rpx; bottom: 30rpx;
    width: 8rpx; background-color: #07c160;
  }
  
  /* --- 右侧内容 --- */
  .right-content {
    flex: 1; height: 100%; background-color: #fff;
  }
  
  .section-header {
    padding: 20rpx 24rpx;
    font-size: 26rpx;
    font-weight: bold;
    color: #666;
    background-color: #fff;
  }
  
  .product-item {
    display: flex;
    padding: 20rpx 24rpx;
    margin-bottom: 20rpx;
  }
  
  .prod-img {
    width: 160rpx; height: 160rpx;
    border-radius: 12rpx;
    background-color: #f9f9f9;
    flex-shrink: 0;
  }
  
  .prod-info {
    flex: 1;
    margin-left: 20rpx;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 160rpx; /* 撑满高度 */
  }
  
  .name { font-size: 30rpx; font-weight: bold; color: #333; }
  .desc { font-size: 22rpx; color: #999; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  
  .price-action { display: flex; justify-content: space-between; align-items: center; }
  .price { font-size: 34rpx; color: #07c160; font-weight: bold; }
  
  /* 加减控件 */
  .stepper { display: flex; align-items: center; }
  .btn {
    width: 48rpx; height: 48rpx; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 36rpx; font-weight: bold;
  }
  .btn.plus { background: #07c160; color: #fff; }
  .btn.minus { border: 1rpx solid #ddd; color: #999; background: #fff; line-height: 44rpx; box-sizing: border-box;}
  .num { margin: 0 20rpx; font-size: 30rpx; font-weight: bold; color: #333; }
  
  /* =========================================
     ⭐⭐⭐ 底部悬浮购物车条 (核心样式) ⭐⭐⭐
     ========================================= */
  .cart-bar-container {
    position: fixed;
    bottom: 30rpx; /* 悬浮在底部 */
    left: 30rpx; right: 30rpx;
    z-index: 100;
  }
  
  .cart-bar {
    height: 100rpx;
    background-color: #222; /* 黑色背景 */
    border-radius: 50rpx;
    display: flex;
    align-items: center;
    padding-left: 130rpx; /* 给凸起的图标留位置 */
    padding-right: 6rpx;
    box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.3);
    position: relative;
  }
  
  /* 凸起的图标圈 */
  .cart-icon-wrapper {
    position: absolute;
    left: 0;
    bottom: 0; /* 贴底 */
    width: 110rpx; height: 110rpx;
    background: #333;
    border-radius: 50%;
    border: 8rpx solid #fff; /* 关键：白色描边，制造镂空感 */
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 -4rpx 10rpx rgba(0,0,0,0.1);
    transition: all 0.2s;
  }
  .cart-icon-wrapper.active {
    background: #07c160; /* 有商品变绿 */
    border-color: #222;   /* 边框变黑，融入背景 */
  }
  
  .cart-icon-img { width: 60rpx; height: 60rpx; }
  
  .badge {
    position: absolute; top: -6rpx; right: -6rpx;
    background: #ff9f43; color: #fff;
    font-size: 20rpx; padding: 4rpx 12rpx;
    border-radius: 20rpx; border: 2rpx solid #fff;
  }
  
  /* 价格信息 */
  .price-info { flex: 1; display: flex; flex-direction: column; justify-content: center; }
  .total-price { font-size: 36rpx; color: #fff; font-weight: bold; }
  .total-price.empty { font-size: 28rpx; color: #999; }
  .sub-text { font-size: 20rpx; color: #888; margin-top: 2rpx;}
  
  /* 结算按钮 */
  .checkout-btn {
    width: 200rpx; height: 88rpx;
    background: #444; color: #999;
    display: flex; align-items: center; justify-content: center;
    border-radius: 0 44rpx 44rpx 0;
    font-size: 30rpx; font-weight: bold;
  }
  .checkout-btn.active {
    background: #07c160; /* 激活变绿 */
    color: #fff;
  }