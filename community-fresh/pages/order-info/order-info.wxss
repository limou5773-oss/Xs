/* 页面整体 */
.order-info-page {
    background-color: #f5f7fa;
    min-height: 100vh;
    padding-bottom: 140rpx;
  }
  
  /* 顶部状态区域 */

 /* 顶部状态区域 */
    .status-header {
        padding: 48rpx 32rpx 80rpx;
        color: #fff;
        border-radius: 0 0 32rpx 32rpx;
        }
        /* 0：待支付（红橙） */
    .status-0 {
        background: linear-gradient(135deg, #ff7a7a, #ff4949);
    }
    
    /* 1：待发货（蓝色） */
    .status-1 {
        background: linear-gradient(135deg, #4facfe, #00c3ff);
    }
    
    /* 2：配送中（橙黄） */
    .status-2 {
        background: linear-gradient(135deg, #4facfe, #00c3ff);
    }
    
    /* 3：已完成（绿色） */
    .status-3 {
        background: linear-gradient(135deg, #90ceaa, #1abc9c);
    }
    
    /* 4：已取消（灰色） */
    .status-4 {
        background: linear-gradient(135deg, #cfd9df, #e2ebf0);
    }
    
    /* 5：售后相关（橙黄） */
    .status-5 {
        background: linear-gradient(135deg, #ffb347, #ffcc33);
    }
  .status-content {
    display: flex;
    align-items: center;
  }
  
  .status-icon {
    width: 96rpx;
    height: 96rpx;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 48rpx;
    margin-right: 24rpx;
  }
  
  .status-text-box {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  .status-title {
    font-size: 34rpx;
    font-weight: 700;
  }
  
  .status-desc {
    margin-top: 8rpx;
    font-size: 26rpx;
    color: #ffe9c2;
  }
  
  /* 通用卡片 */
  .card {
    margin: -40rpx 24rpx 20rpx;
    background: #fff;
    border-radius: 24rpx;
    padding: 28rpx 24rpx;
    box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.05);
  }
  
  /* 地址卡片往下浮一层 */
  .address-card-float {
    margin-top: -36rpx;
  }
  
  /* 地址区域 */
  .addr-group {
    display: flex;
    align-items: flex-start;
  }
  
  .addr-icon {
    width: 64rpx;
    height: 64rpx;
    border-radius: 50%;
    background: #fff2e0;
    color: #ff7a3c;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 20rpx;
    font-size: 32rpx;
  }
  
  .addr-info {
    flex: 1;
  }
  
  .user-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 4rpx;
  }
  
  .name {
    font-size: 30rpx;
    font-weight: 600;
    color: #111827;
  }
  
  .phone {
    font-size: 28rpx;
    color: #6b7280;
  }
  
  .addr-detail {
    font-size: 26rpx;
    color: #6b7280;
    line-height: 1.5;
  }
  
  /* 卡片标题 */
  .card-header-row {
    margin-bottom: 16rpx;
  }
  
  .card-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #111827;
  }
  
  /* 商品列表 */
  .item {
    display: flex;
    padding: 18rpx 0;
    border-top: 1rpx solid #f3f4f6;
  }
  
  .item:first-of-type {
    border-top-width: 0;
  }
  
  .item-img {
    width: 140rpx;
    height: 140rpx;
    border-radius: 16rpx;
    margin-right: 20rpx;
    background: #f9fafb;
  }
  
  .item-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  
  .item-info .name {
    font-size: 30rpx;
    color: #111827;
  }
  
  .price-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 8rpx;
  }
  
  .price {
    font-size: 30rpx;
    color: #e11d48;
    font-weight: 600;
  }
  
  .qty {
    font-size: 26rpx;
    color: #9ca3af;
  }
  
  /* 订单信息/售后信息行 */
  .row-small {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10rpx 0;
    font-size: 26rpx;
  }
  
  .row-big {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16rpx 0 4rpx;
    font-size: 28rpx;
  }
  
  .label {
    color: #6b7280;
  }
  
  .val {
    color: #111827;
    max-width: 460rpx;
    text-align: right;
    word-break: break-all;
  }
  
  .pay-price {
    color: #e11d48;
    font-size: 32rpx;
    font-weight: 700;
  }
  
  .price-red {
    color: #e11d48;
    font-weight: 700;
  }
  
  .divider {
    margin: 10rpx 0 6rpx;
    height: 1rpx;
    background: #f3f4f6;
  }
  
  /* 售后卡片 */
  .refund-card {
    margin-top: 16rpx;
  }
  
  .refund-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6rpx;
  }
  
  .refund-badge {
    padding: 4rpx 18rpx;
    border-radius: 999rpx;
    font-size: 22rpx;
    border: 1rpx solid transparent;
  }
  
  /* 待处理 */
  .badge-pending {
    background: #fff7ed;
    color: #f97316;
    border-color: #fed7aa;
  }
  
  /* 成功 */
  .badge-success {
    background: #ecfdf3;
    color: #16a34a;
    border-color: #bbf7d0;
  }
  
  /* 拒绝 */
  .badge-danger {
    background: #fef2f2;
    color: #dc2626;
    border-color: #fecaca;
  }
  
  /* 已取消 */
  .badge-close {
    background: #eff6ff;
    color: #2563eb;
    border-color: #bfdbfe;
  }
  
  /* 底部按钮区域 */
  .footer-btn-area {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 12rpx 24rpx 30rpx;
    background: #ffffff;
    box-shadow: 0 -6rpx 16rpx rgba(15, 23, 42, 0.04);
    z-index: 50;
  }
  
  .main-btn {
    width: 100%;
    margin: 0;
    height: 88rpx;
    line-height: 88rpx;
    border-radius: 999rpx;
    font-size: 30rpx;
    font-weight: 600;
  }
  
  /* 支付按钮 */
  .pay-btn {
    background: linear-gradient(135deg, #07c160, #06a052);
    color: #fff;
    border: none;
  }
  
  /* 申请售后按钮 */
  .refund-btn {
    background: linear-gradient(135deg, #f97316, #fb923c);
    color: #fff;
    border: none;
  }
  
  /* 取消售后按钮 */
  .cancel-btn {
    background: #ffffff;
    color: #111827;
    border: 1rpx solid #e5e7eb;
  }
  
  /* 再来一单按钮 */
  .again-btn {
    background: #07c160;
    color: #fff;
    border: none;
  }
  
  /* 支付弹窗遮罩 */
  .pay-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.55);
    z-index: 999;
    visibility: hidden;
    opacity: 0;
    transition: all 0.25s;
  }
  
  .pay-mask.show {
    visibility: visible;
    opacity: 1;
  }
  
  /* 支付弹窗主体 */
  .pay-panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background: #fff;
    border-radius: 32rpx 32rpx 0 0;
    padding: 40rpx 40rpx 60rpx;
    transform: translateY(100%);
    transition: transform 0.25s;
  }
  
  .pay-mask.show .pay-panel {
    transform: translateY(0);
  }
  
  .panel-header {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }
  
  .panel-title {
    font-size: 32rpx;
    font-weight: 700;
    color: #111827;
  }
  
  .close-icon {
    position: absolute;
    right: 0;
    top: -8rpx;
    font-size: 40rpx;
    color: #9ca3af;
    padding: 10rpx;
  }
  
  .price-area {
    text-align: center;
    margin: 40rpx 0 48rpx;
  }
  
  .price-area .currency {
    font-size: 32rpx;
    font-weight: 700;
    color: #111827;
  }
  
  .price-area .amount {
    font-size: 64rpx;
    font-weight: 800;
    color: #111827;
  }
  
  .method-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 26rpx 0;
    border-top: 1rpx solid #f3f4f6;
    border-bottom: 1rpx solid #f3f4f6;
    margin-bottom: 40rpx;
    font-size: 28rpx;
    color: #4b5563;
  }
  
  .method-val {
    display: flex;
    align-items: center;
  }
  
  .wx-icon {
    margin-right: 8rpx;
    font-size: 32rpx;
  }
  
  .confirm-pay-btn {
    width: 100%;
    height: 88rpx;
    line-height: 88rpx;
    border-radius: 999rpx;
    background: #07c160;
    color: #fff;
    font-size: 32rpx;
    font-weight: 700;
  }
  
  .confirm-pay-btn:active {
    background: #05944f;
  }
  