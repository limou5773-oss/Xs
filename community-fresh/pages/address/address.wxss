/* 全局背景 */
.address-page {
    background-color: #F7F8FA; /* 极淡的冷灰 */
    min-height: 100vh;
    padding-bottom: 180rpx;
    box-sizing: border-box;
    position: relative;
  }
  
  /* 顶部氛围渐变 (增加纵深感) */
  .bg-gradient {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 300rpx;
    background: linear-gradient(180deg, #E8F5E9 0%, rgba(247,248,250,0) 100%);
    z-index: 0;
    pointer-events: none;
  }
  
  /* --- 顶部标题 --- */
  .page-header {
    position: relative;
    z-index: 1;
    padding: 40rpx 32rpx 30rpx;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .main-title {
    font-size: 44rpx;
    font-weight: 800; /* 特粗字体 */
    color: #1a1a1a;
    letter-spacing: 1rpx;
  }
  
  .sub-info {
    font-size: 24rpx;
    color: #999;
    background: rgba(255,255,255,0.6);
    padding: 6rpx 16rpx;
    border-radius: 30rpx;
    border: 1rpx solid #eee;
  }
  
  /* 列表容器 */
  .list-container {
    padding: 0 28rpx;
    position: relative;
    z-index: 1;
  }
  
  /* --- 卡片核心样式 (普通状态) --- */
  .address-card {
    background: #fff;
    border-radius: 28rpx; /* 大圆角 */
    margin-bottom: 30rpx;
    /* 弥散阴影：颜色淡、模糊大、位移小 = 高级悬浮感 */
    box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.04);
    position: relative;
    overflow: hidden;
    border: 2rpx solid transparent; /* 预留边框位置 */
    transition: all 0.3s ease;
    
    /* 进场动画 */
    opacity: 0;
    animation: slideUpFade 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }
  
  /* --- ⭐ 层次感升级：默认地址高亮样式 --- */
  .card-default {
    /* 给个极淡的绿色背景，区分普通卡片 */
    background: #FDFDFD;
    /* 绿色描边 */
    border-color: #42b983; 
    /* 阴影带一点点绿色 */
    box-shadow: 0 12rpx 30rpx rgba(66, 185, 131, 0.12);
  }
  
  /* 瀑布流延迟 */
  .address-card:nth-child(1) { animation-delay: 0.05s; }
  .address-card:nth-child(2) { animation-delay: 0.1s; }
  .address-card:nth-child(3) { animation-delay: 0.15s; }
  .address-card:nth-child(4) { animation-delay: 0.2s; }
  
  @keyframes slideUpFade {
    from { opacity: 0; transform: translateY(40rpx); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  /* --- 信息区域 --- */
  .info-section {
    padding: 36rpx 36rpx 28rpx;
  }
  
  .user-row {
    display: flex;
    align-items: center;
    margin-bottom: 16rpx;
  }
  
  .name {
    font-size: 34rpx;
    font-weight: bold;
    color: #222;
    margin-right: 20rpx;
  }
  
  .phone {
    font-size: 30rpx;
    color: #555;
    font-family: 'DIN', Helvetica, sans-serif; /* 假如你想让数字更好看 */
    font-weight: 600;
  }
  
  .tag-default {
    margin-left: auto; /* 靠右对齐 */
    background: linear-gradient(135deg, #42b983, #2c9c6a);
    color: #fff;
    font-size: 20rpx;
    padding: 6rpx 16rpx;
    border-radius: 8rpx 0 8rpx 0; /* 异形圆角 */
    font-weight: bold;
    box-shadow: 2rpx 4rpx 10rpx rgba(66, 185, 131, 0.3);
  }
  
  .address-row {
    display: flex;
    align-items: flex-start; /* 顶部对齐 */
  }
  
  .icon-loc {
    font-size: 30rpx;
    margin-right: 12rpx;
    margin-top: 2rpx;
    opacity: 0.8;
  }
  
  .detail {
    font-size: 28rpx;
    color: #666;
    line-height: 1.5;
    flex: 1;
    text-align: justify;
  }
  
  /* --- 操作条 (独立块面设计) --- */
  .action-bar {
    background: #F9FAFC; /* 浅灰底色，与白底区分 */
    padding: 24rpx 36rpx;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    border-top: 1rpx solid #F0F2F5;
  }
  
  .btn-item {
    display: flex;
    align-items: center;
    font-size: 26rpx;
    padding: 10rpx 20rpx;
    border-radius: 30rpx;
    transition: background 0.2s;
  }
  
  /* 编辑按钮文字色 */
  .btn-item.edit { color: #475569; }
  /* 删除按钮文字色 */
  .btn-item.delete { color: #EF4444; }
  
  /* 按钮点击态 */
  .btn-item:active { background: #E2E8F0; }
  
  .btn-icon {
    margin-right: 8rpx;
    font-size: 28rpx;
  }
  
  /* 按钮之间的竖线 */
  .vertical-line {
    width: 1rpx;
    height: 24rpx;
    background: #CBD5E1;
    margin: 0 10rpx;
  }
  
  /* --- 空状态 --- */
  .empty-state {
    padding-top: 200rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .empty-img { width: 240rpx; height: 240rpx; opacity: 0.8; margin-bottom: 30rpx; }
  .empty-title { font-size: 32rpx; color: #333; font-weight: 600; margin-bottom: 10rpx; }
  .empty-desc { font-size: 26rpx; color: #999; }
  
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  .animate-fade-in { animation: fadeIn 0.8s ease-out; }
  
  /* --- 底部按钮 --- */
  .footer-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: rgba(255,255,255,0.95); /* 毛玻璃感 */
    backdrop-filter: blur(10px);
    padding: 20rpx 40rpx 60rpx;
    box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.03);
    box-sizing: border-box;
    z-index: 100;
    /* 按钮也加上场动画 */
    animation: slideUpFade 0.6s ease-out 0.3s forwards;
    opacity: 0;
  }
  
  .add-btn {
    /* 墨绿到亮绿渐变，更稳重 */
    background: linear-gradient(135deg, #10B981, #059669);
    color: #fff;
    font-size: 32rpx;
    font-weight: 600;
    border-radius: 60rpx; /* 胶囊形状 */
    padding: 26rpx 0;
    box-shadow: 0 10rpx 24rpx rgba(16, 185, 129, 0.3); /* 彩色投影 */
    display: flex;
    justify-content: center;
    align-items: center;
  }
  
  .plus {
    font-size: 44rpx;
    margin-right: 12rpx;
    margin-top: -6rpx;
  }