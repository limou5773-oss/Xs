/* pages/cart/cart.wxss */
page {
    background-color: #f5f6fa;
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
    padding-bottom: 120rpx;
  }
  .container { padding: 20rpx; box-sizing: border-box; }
  
  /* 顶部标题 */
  .page-header {
    padding: 10rpx 10rpx 30rpx; display: flex; justify-content: space-between; align-items: center;
  }
  .header-left { display: flex; align-items: baseline; }
  .header-title { font-size: 48rpx; font-weight: 800; color: #333; margin-right: 12rpx; }
  .header-count { font-size: 28rpx; color: #999; font-weight: normal; }
  .manage-btn { font-size: 28rpx; color: #333; font-weight: bold; padding: 10rpx; }
  
  /* 顶部引导 */
  .top-banner {
    background: #fff; border-radius: 16rpx; padding: 20rpx 30rpx;
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 24rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.02);
  }
  .banner-text { display: flex; flex-direction: column; }
  .main-txt { font-size: 30rpx; font-weight: bold; color: #333; }
  .sub-txt { font-size: 22rpx; color: #999; margin-top: 6rpx; }
  .go-arrow { font-size: 24rpx; color: #07c160; font-weight: bold; }
  
  /* 列表项 */
  .cart-item {
    background: #fff; border-radius: 24rpx; padding: 24rpx;
    display: flex; align-items: center; margin-bottom: 24rpx;
    box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03); position: relative;
  }
  .checkbox-area { width: 70rpx; height: 100%; display: flex; align-items: center; }
  .goods-img { width: 160rpx; height: 160rpx; border-radius: 16rpx; background: #f9f9f9; margin-right: 24rpx; flex-shrink: 0; }
  .goods-info { flex: 1; height: 160rpx; display: flex; flex-direction: column; justify-content: space-between; }
  .info-top { display: flex; justify-content: space-between; align-items: flex-start; }
  .goods-name { font-size: 30rpx; color: #333; font-weight: bold; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; line-height: 1.4; }
  
  .action-row { display: flex; justify-content: space-between; align-items: flex-end; }
  .price { font-size: 36rpx; color: #ff4d4f; font-weight: 800; }
  
  /* 步进器 */
  .stepper { display: flex; align-items: center; background: #f7f8fa; border-radius: 30rpx; padding: 4rpx; }
  .btn { width: 50rpx; height: 50rpx; border-radius: 50%; background: #fff; color: #333; display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: bold; box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.05); }
  .btn:active { transform: scale(0.9); background: #eee; }
  .btn.plus { color: #07c160; }
  .btn.minus.disabled { color: #ccc; background: transparent; box-shadow: none; }
  .num { min-width: 60rpx; text-align: center; font-size: 28rpx; font-weight: bold; color: #333; }
  
  /* ⭐⭐⭐ 空状态 (居中大字) ⭐⭐⭐ */
  .empty-state {
    height: 50vh; /* 占据屏幕一半高度 */
    display: flex; flex-direction: column; 
    align-items: center; justify-content: center;
  }
  .empty-icon { width: 200rpx; height: 200rpx; opacity: 0.4; margin-bottom: 40rpx; }
  .empty-text { 
    font-size: 34rpx; /* 字体加大 */
    color: #999; 
    font-weight: bold; 
    letter-spacing: 2rpx; 
  }
  
  /* 猜你喜欢 */
  .recommend-box { margin-top: 20rpx; }
  .rec-header { display: flex; align-items: center; justify-content: center; margin-bottom: 30rpx; }
  .line { width: 40rpx; height: 2rpx; background: #ddd; }
  .rec-title { margin: 0 20rpx; font-size: 28rpx; color: #999; font-weight: bold; }
  .rec-list { display: flex; flex-wrap: wrap; justify-content: space-between; }
  .rec-item { width: 48%; background: #fff; border-radius: 16rpx; margin-bottom: 24rpx; padding-bottom: 20rpx; overflow: hidden; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.02); }
  .rec-img { width: 100%; height: 340rpx; background: #f9f9f9; }
  .rec-name { font-size: 28rpx; color: #333; margin: 16rpx 16rpx 8rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; }
  .rec-price-row { display: flex; justify-content: space-between; align-items: center; padding: 0 16rpx; }
  .rec-price { font-size: 32rpx; color: #ff4d4f; font-weight: bold; }
  .rec-add { width: 44rpx; height: 44rpx; background: #07c160; color: #fff; border-radius: 50%; text-align: center; line-height: 40rpx; font-size: 36rpx; }
  
  /* 底部栏 */
  .footer-bar-wrapper { position: fixed; bottom: 0; left: 0; right: 0; z-index: 99; background: #fff; padding-bottom: env(safe-area-inset-bottom); }
  .footer-bar { height: 110rpx; display: flex; align-items: center; padding: 0 30rpx; box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05); }
  .select-all { display: flex; align-items: center; margin-right: 20rpx; }
  .select-text { font-size: 28rpx; color: #666; margin-left: 12rpx; }
  .total-box { flex: 1; text-align: right; margin-right: 30rpx; display: flex; align-items: baseline; justify-content: flex-end; }
  .label { font-size: 26rpx; color: #333; margin-right: 8rpx; }
  .total-price { font-size: 40rpx; color: #ff4d4f; font-weight: 800; }
  .checkout-btn { width: 220rpx; height: 80rpx; background: linear-gradient(90deg, #ff8e1d, #ff4b2b); color: #fff; border-radius: 40rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: bold; box-shadow: 0 6rpx 16rpx rgba(255, 75, 43, 0.3); }
  .delete-confirm-btn { width: 180rpx; height: 76rpx; border: 2rpx solid #ff4d4f; color: #ff4d4f; border-radius: 38rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: bold; }