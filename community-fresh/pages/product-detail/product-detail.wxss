/* pages/product-detail/product-detail.wxss */
page {
    background-color: #f0f2f5;
    font-family: "PingFang SC", sans-serif;
  }
  
  /* 1. 图片 */
  .gallery {
    width: 100%;
    height: 700rpx;
    position: relative;
  }
  .main-img { width: 100%; height: 100%; }
  .sold-out-mask {
    position: absolute; top: 0;
    left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.5); color: #fff;
    display: flex; justify-content: center; align-items: center; font-size: 40rpx; font-weight: bold;
    backdrop-filter: blur(4px);
  }
  
  /* 2. 渐变价格条 (视觉重心) */
  .price-banner {
    background: linear-gradient(90deg, #ff416c, #ff4b2b);
    color: #fff;
    padding: 24rpx 30rpx;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .left-price { display: flex;
  align-items: baseline; }
  .symbol { font-size: 32rpx; margin-right: 4rpx; }
  .amount { font-size: 56rpx; font-weight: bold; line-height: 1;
  }
  .unit { font-size: 26rpx; margin-left: 10rpx; opacity: 0.9;
  }
  
  .right-stat {
    font-size: 24rpx;
    background: rgba(0,0,0,0.15);
    padding: 6rpx 16rpx;
    border-radius: 30rpx;
    display: flex;
    align-items: center;
  }
  .hot-icon { margin-right: 6rpx; }
  
  /* 3. 信息卡片 */
  .info-card {
    background: #fff;
    margin-bottom: 20rpx;
    padding: 30rpx;
    border-radius: 0 0 24rpx 24rpx;
  }
  
  .title-row {
    display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24rpx;
  }
  .product-title {
    font-size: 36rpx; font-weight: 800; color: #333; line-height: 1.4; flex: 1; margin-right: 20rpx;
  }
  .share-btn {
    background: #f8f8f8; padding: 10rpx 24rpx; border-radius: 40rpx;
    font-size: 22rpx; color: #666; line-height: 1;
    margin: 0;
    display: flex; align-items: center;
  }
  .share-btn::after { border: none;
  }
  
  /* 彩色标签 */
  .tags-wrapper { display: flex; flex-wrap: wrap; margin-bottom: 30rpx;
  }
  .tag {
    padding: 6rpx 16rpx; font-size: 22rpx; border-radius: 8rpx; margin-right: 16rpx; font-weight: bold;
  }
  .tag.orange { color: #ff6b00; background: #fff0e6; }
  .tag.green  { color: #07c160; background: #e8f8f0;
  }
  .tag.blue   { color: #007aff; background: #e6f4ff;
  }
  
  /* 服务条 */
  .service-bar {
    border-top: 1rpx solid #f5f5f5;
    padding-top: 20rpx;
    display: flex;
    justify-content: space-between;
  }
  .item { font-size: 24rpx; color: #666; display: flex; align-items: center;
  }
  .check { color: #07c160; margin-right: 6rpx; font-weight: bold;}
  
  /* 4. 详情区 */
  .detail-section {
    background: #fff;
    padding: 30rpx;
    border-radius: 24rpx;
    margin: 20rpx 0;
  }
  .section-header {
    display: flex; justify-content: center; align-items: center;
    margin-bottom: 30rpx;
  }
  .header-title { font-size: 30rpx; font-weight: bold; color: #333; margin: 0 20rpx;
  }
  .dot { width: 8rpx; height: 8rpx; background: #ccc; border-radius: 50%; transform: rotate(45deg);
  }
  
  .content-box {
    color: #555; font-size: 28rpx; line-height: 1.8;
  }
  
  /* ================= 5. 商品评价区块样式 (新增) ================= */
  .review-section {
    background: #ffffff;
    margin: 20rpx 0;
    padding: 30rpx;
    border-radius: 24rpx;
    box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02);
  }
  
  .review-header {
    margin-bottom: 30rpx;
  }
  
  .review-title {
    font-size: 30rpx;
    font-weight: bold;
    color: #333;
  }
  
  .review-item {
    border-bottom: 1rpx solid #f1f5f9;
    padding-bottom: 24rpx;
    margin-bottom: 24rpx;
  }
  .review-item:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  
  .user-info {
    display: flex;
    align-items: center;
    margin-bottom: 16rpx;
  }
  
  .avatar {
    width: 64rpx;
    height: 64rpx;
    border-radius: 50%;
    margin-right: 20rpx;
    background-color: #f5f5f5;
  }
  
  .nickname {
    font-size: 28rpx;
    color: #475569;
    flex: 1;
  }
  
  /* 评分小徽章 */
  .star-badge {
    background: #fff8e1;
    padding: 4rpx 16rpx;
    border-radius: 20rpx;
    display: flex;
    align-items: center;
  }
  
  .star-num {
    color: #fa9d3b;
    font-size: 26rpx;
    font-weight: bold;
    margin-right: 4rpx;
  }
  
  .star-icon {
    color: #fa9d3b;
    font-size: 22rpx;
  }
  
  .review-content {
    font-size: 28rpx;
    color: #1e293b;
    line-height: 1.6;
    margin-bottom: 16rpx;
  }
  
  .review-time {
    font-size: 24rpx;
    color: #94a3b8;
  }
  
  /* 6. 底部栏 */
  .bottom-bar {
    position: fixed; bottom: 0; left: 0;
    right: 0;
    height: 110rpx; background: #fff;
    display: flex; align-items: center; padding: 0 24rpx;
    padding-bottom: env(safe-area-inset-bottom);
    box-shadow: 0 -4rpx 10rpx rgba(0,0,0,0.05);
    z-index: 99;
  }
  
  .nav-group { display: flex; margin-right: 30rpx;
  }
  .nav-item {
    display: flex; flex-direction: column; align-items: center; margin-right: 36rpx;
    font-size: 20rpx; color: #666;
  }
  .nav-ico { font-size: 38rpx; margin-bottom: 4rpx; }
  
  .btn-wrapper { flex: 1;
  }
  .buy-btn {
    height: 80rpx; 
    background: linear-gradient(90deg, #ff8e1d, #ff4b2b);
    color: #fff; border-radius: 40rpx;
    display: flex; align-items: center; justify-content: center;
    font-size: 30rpx; font-weight: bold;
    box-shadow: 0 6rpx 16rpx rgba(255, 75, 43, 0.3);
  }
  .buy-btn:active { opacity: 0.9; transform: scale(0.98);
  }
  .buy-btn.disabled { background: #ccc; box-shadow: none; pointer-events: none; }