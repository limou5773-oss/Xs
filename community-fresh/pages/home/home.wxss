/* pages/home/home.wxss */

/* ================================= 动画定义 ================================= */
@keyframes fadeInUp { from { opacity: 0; transform: translate3d(0, 40rpx, 0); } to { opacity: 1; transform: none; } }
@keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-12rpx); } }
@keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.7; } 100% { opacity: 1; } }

/* ================================= 全局布局 ================================= */
page {
  background-color: #f7f8fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
  color: #333;
  box-sizing: border-box;
}
.container { padding: 0 24rpx 40rpx; width: 100%; box-sizing: border-box; }

/* ================================= 顶部店铺 ================================= */
.header-section { padding: 24rpx 0; animation: fadeInUp 0.6s ease both; }
.shop-card { display: flex; align-items: center; }
.shop-logo-box { width: 80rpx; height: 80rpx; background: #fff; border-radius: 12rpx; margin-right: 20rpx; border: 1rpx solid #eee; overflow: hidden; }
.shop-logo { width: 100%; height: 100%; background-color: #f0f0f0; }
.shop-details { flex: 1; display: flex; flex-direction: column; justify-content: center; }
.shop-name-row { display: flex; align-items: center; margin-bottom: 6rpx; }
.shop-name { font-size: 34rpx; font-weight: bold; color: #333; }
.shop-tag { font-size: 22rpx; color: #666; opacity: 0.8; }

/* ================================= ⭐⭐⭐ 新增：公告栏 ⭐⭐⭐ ================================= */
.notice-box {
  background: #fffbe8; /* 淡黄色背景 */
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.notice-icon { font-size: 32rpx; margin-right: 16rpx; animation: pulse 2s infinite; }
.notice-swiper { flex: 1; height: 100%; }
.notice-text {
  font-size: 26rpx; color: #ed6a0c; line-height: 72rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

/* ================================= 配送状态卡片 ================================= */
.delivery-card {
  background: linear-gradient(135deg, #07c160, #20b055); border-radius: 24rpx; padding: 30rpx;
  color: white; display: flex; justify-content: space-between; align-items: center;
  box-shadow: 0 10rpx 20rpx rgba(7, 193, 96, 0.25); margin-bottom: 30rpx; position: relative; overflow: hidden;
  animation: fadeInUp 0.6s ease 0.1s both;
}
.card-left { flex: 1; z-index: 2; }
.status-row { display: flex; align-items: center; margin-bottom: 16rpx; }
.tag-self { font-size: 20rpx; background: rgba(255, 255, 255, 0.2); border: 1rpx solid rgba(255, 255, 255, 0.6); padding: 2rpx 10rpx; border-radius: 8rpx; margin-right: 12rpx; font-weight: bold; }
.status-text { font-size: 28rpx; font-weight: 500; animation: pulse 2s infinite ease-in-out; }
.time-row { display: flex; align-items: baseline; margin-bottom: 24rpx; }
.time-val-text { font-size: 32rpx; font-weight: bold; line-height: 1.4; opacity: 0.9; }
.driver-box { background: rgba(0, 0, 0, 0.1); display: inline-flex; align-items: center; padding: 8rpx 20rpx; border-radius: 30rpx; font-size: 24rpx; }
.call-btn { margin-left: 16rpx; padding-left: 16rpx; border-left: 1rpx solid rgba(255, 255, 255, 0.3); display: flex; align-items: center; }
.call-btn:active { opacity: 0.7; }
.card-right { display: flex; align-items: center; justify-content: center; }
.delivery-img { width: 100rpx; height: 100rpx; opacity: 0.95; animation: float 2.5s ease-in-out infinite; }
.animate-float { animation: float 2.5s ease-in-out infinite; }

/* ================================= 热门分类 ================================= */
.category-card {
  background: #fff; border-radius: 24rpx; margin-bottom: 30rpx; padding: 30rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02); animation: fadeInUp 0.6s ease 0.2s both;
}
.category-header { padding: 0 10rpx; margin-bottom: 24rpx; display: flex; justify-content: space-between; align-items: center; }
.grid-menu { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20rpx; background: transparent; padding: 0; box-shadow: none; }
.text-grid-item {
  width: 100%; height: 72rpx; display: flex; align-items: center; justify-content: center;
  background-color: #F7F8FA; border-radius: 12rpx; border: none; transition: all 0.2s;
}
.text-grid-item:active { background-color: #E8F5E9; transform: scale(0.96); }
.menu-name { font-size: 26rpx; color: #333; font-weight: 500; letter-spacing: 1rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ================================= 商品列表 ================================= */
.recommend-section { width: 100%; animation: fadeInUp 0.6s ease 0.3s both; }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; padding: 0 4rpx; }
.section-title { font-size: 36rpx; font-weight: 800; color: #333; }
.section-more { display: flex; align-items: center; padding: 10rpx 0 10rpx 20rpx; }
.section-more text { font-size: 26rpx; color: #999; }
.section-more .arrow { margin-left: 6rpx; font-weight: bold; }
.product-list { display: flex; flex-wrap: wrap; justify-content: space-between; }
.product-card {
  width: 48%; background: #fff; border-radius: 16rpx; overflow: hidden;
  margin-bottom: 24rpx; box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  position: relative; transition: transform 0.1s;
}
.product-card:active { transform: scale(0.98); }
.img-box { width: 100%; height: 340rpx; background: #f9f9f9; position: relative; }
.prod-img { width: 100%; height: 100%; }
.placeholder { background-color: #f0f2f5; }
.sold-out-mask {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.5); color: #fff;
  display: flex; justify-content: center; align-items: center; font-weight: bold; font-size: 32rpx; z-index: 10;
}
.prod-info { padding: 16rpx 20rpx; }
.prod-name { font-size: 28rpx; color: #333; font-weight: bold; margin-bottom: 10rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; }
.tags-row { margin-bottom: 14rpx; min-height: 32rpx; display: flex; }
.tag-badge { font-size: 20rpx; color: #07c160; background: #e8f8f0; padding: 2rpx 10rpx; border-radius: 8rpx; }
.price-row { display: flex; justify-content: space-between; align-items: flex-end; }
.price-box { display: flex; align-items: baseline; }
.currency { font-size: 24rpx; color: #fa5151; font-weight: bold; }
.price { font-size: 38rpx; color: #fa5151; font-weight: bold; margin: 0 4rpx; line-height: 1; }
.unit { font-size: 22rpx; color: #999; }
.add-btn {
  width: 52rpx; height: 52rpx; background: #07c160; border-radius: 50%; color: #fff;
  text-align: center; line-height: 48rpx; font-size: 40rpx;
  box-shadow: 0 4rpx 10rpx rgba(7, 193, 96, 0.3); transition: all 0.1s;
}
.add-btn:active { transform: scale(0.9) rotate(90deg); background: #06ad56; }
.add-btn.disabled { background: #e0e0e0; box-shadow: none; pointer-events: none; }
.loading-footer { text-align: center; padding: 30rpx 0 10rpx; width: 100%; }
.loading-footer text { font-size: 24rpx; color: #999; display: block; }
.no-more { opacity: 0.6; }
.empty { margin-top: 100rpx; font-size: 28rpx; color: #ccc; }