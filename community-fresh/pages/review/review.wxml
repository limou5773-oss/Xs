<view class="review-container">
  <view class="section">
    <text class="label">评分：</text>
    <view class="stars">
      <block wx:for="{{[0, 1, 2, 3, 4]}}" wx:key="*this">
        <view 
          class="star {{index < rating ? 'active' : ''}}" 
          bindtap="setRating" 
          data-index="{{index}}">
          {{index < rating ? '★' : '☆'}}
        </view>
      </block>
    </view>
  </view>

  <view class="section">
    <text class="label">评价内容：</text>
    <textarea
      placeholder="请输入对商品或服务的评价..."
      value="{{content}}"
      bindinput="onInput"
      maxlength="200"
    ></textarea>
  </view>

  <button class="submit-btn" bindtap="onSubmit">提交评价</button>
</view>