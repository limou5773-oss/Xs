.review-container {
    padding: 30rpx;
    background-color: #f7f7f7;
    min-height: 100vh;
  }
  
  .section {
    background-color: #fff;
    border-radius: 12rpx;
    padding: 20rpx;
    margin-bottom: 30rpx;
  }
  
  .label {
    font-size: 28rpx;
    color: #333;
    display: block;
    margin-bottom: 10rpx;
  }
  
  .stars {
    display: flex;
    align-items: center;
  }
  
  .star {
    width: 60rpx;
    height: 60rpx;
    margin-right: 10rpx;
  }
  
  textarea {
    width: 100%;
    min-height: 200rpx;
    border: 1rpx solid #ddd;
    border-radius: 8rpx;
    padding: 20rpx;
    font-size: 28rpx;
    box-sizing: border-box;
  }
  
  .submit-btn {
    background-color: #07c160;
    color: #fff;
    font-size: 30rpx;
    padding: 20rpx 0;
    border-radius: 8rpx;
  }
  