/* 全局背景 */
.edit-container {
    padding: 40rpx;
    background: #f7f8fa; /* 浅灰背景 */
    min-height: 100vh;
    box-sizing: border-box;
  }
  
  /* --- 头像区域 --- */
  .avatar-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 40rpx;
    margin-bottom: 60rpx;
  }
  
  /* 核心：重置微信默认按钮样式 */
  .avatar-wrapper {
    padding: 0;
    width: 180rpx !important;
    height: 180rpx !important;
    background: transparent;
    border-radius: 50%;
    margin: 0;
    /* 消除默认边框 */
    border: none;
    outline: none;
  }
  
  .avatar-wrapper::after {
    border: none;
  }
  
  /* 头像图片样式 */
  .avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    /* 纯白描边 + 柔和投影 */
    border: 6rpx solid #fff;
    box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
    background-color: #eee;
  }
  
  .tip {
    font-size: 26rpx;
    color: #999;
    margin-top: 24rpx;
  }
  
  /* --- 表单区域 --- */
  .form-box {
    background: #fff;
    border-radius: 24rpx;
    padding: 0 40rpx;
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.02);
  }
  
  .form-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 36rpx 0;
    /* border-bottom 可以去掉，因为只有一项 */
    /* border-bottom: 1rpx solid #f9f9f9; */
  }
  
  .label {
    font-size: 30rpx;
    color: #333;
    font-weight: bold;
    width: 120rpx;
  }
  
  .input {
    flex: 1;
    text-align: right;
    color: #333;
    font-size: 30rpx;
    height: 60rpx; /* 增加点击区域高度 */
  }
  
  .placeholder {
    color: #ccc;
  }
  
  /* --- 保存按钮 --- */
  .save-btn {
    /* 渐变绿，与个人中心风格统一 */
    background: linear-gradient(135deg, #07c160, #0ebf5c);
    color: white;
    border-radius: 50rpx;
    margin-top: 80rpx;
    padding: 24rpx 0;
    font-size: 32rpx;
    font-weight: 600;
    /* 绿色投影 */
    box-shadow: 0 10rpx 20rpx rgba(7, 193, 96, 0.25);
    border: none;
  }
  
  .save-btn:active {
    opacity: 0.9;
    transform: scale(0.98);
  }