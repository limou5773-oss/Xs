<view class="edit-page">
  
  <view class="page-header">
    <text class="title">{{form.id ? '编辑收货地址' : '新增收货地址'}}</text>
  </view>

  <view class="form-card animate-slide-up">
    
    <view class="form-item">
      <text class="label">收货人</text>
      <input class="input" placeholder="名字" placeholder-class="ph-style" value="{{form.name}}" bindinput="onInput" data-field="name" />
    </view>

    <view class="form-item">
      <text class="label">手机号码</text>
      <input class="input" type="number" maxlength="11" placeholder="手机号" placeholder-class="ph-style" value="{{form.phone}}" bindinput="onInput" data-field="phone" />
    </view>

    <view class="form-item">
      <text class="label">所在地区</text>
      <picker class="picker-box" mode="region" bindchange="onRegionChange" value="{{region}}">
        <view class="picker-content">
          <view wx:if="{{form.region}}" class="picker-text">{{form.region}}</view>
          <view wx:else class="picker-placeholder">省、市、区</view>
        </view>
      </picker>
      <text class="arrow">›</text>
    </view>

    <view class="form-item align-top no-border">
      <text class="label">详细地址</text>
      <textarea 
        class="textarea" 
        placeholder="小区楼栋、门牌号等" 
        placeholder-class="ph-style" 
        value="{{form.detail}}" 
        bindinput="onInput" 
        data-field="detail" 
        auto-height
        disable-default-padding
      />
    </view>

  </view>

  <view class="form-card switch-card animate-slide-up delay-1">
    <view class="switch-row">
      <view class="switch-text">
        <text class="switch-title">设为默认地址</text>
        <text class="switch-desc">下单时会自动推荐使用该地址</text>
      </view>
      <switch checked="{{form.isDefault}}" bindchange="onSwitch" color="#07c160" style="transform: scale(0.8);" />
    </view>
  </view>

  <view class="bottom-bar">
    <button class="save-btn" bindtap="save">保存地址</button>
  </view>

</view>