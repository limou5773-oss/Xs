/* 全局背景 */
.order-page {
    background-color: #F5F7FA;
    min-height: 100vh;
    padding-bottom: 60rpx;
  }
  
  /* =================================
     1. Tab 栏 (吸顶)
     ================================= */
  .tabs-wrapper {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #fff;
    box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
  }
  
  .tabs {
    white-space: nowrap;
    height: 96rpx;
    display: flex;
    align-items: center;
    padding: 0 16rpx;
  }
  
  .tab-item {
    display: inline-block;
    padding: 0 40rpx;
    height: 96rpx;
    line-height: 96rpx;
    font-size: 28rpx;
    color: #64748B;
    position: relative;
    transition: all 0.3s;
  }
  
  .tab-item.active {
    color: #1a1a1a;
    font-weight: 800;
    font-size: 32rpx;
    transform: scale(1.02);
  }
  
  .tab-line {
    position: absolute;
    bottom: 16rpx;
    left: 50%;
    transform: translateX(-50%);
    width: 36rpx;
    height: 8rpx;
    background: linear-gradient(90deg, #07c160, #85e4a3);
    border-radius: 4rpx;
  }
  
  /* =================================
     2. 订单列表容器
     ================================= */
  .list-container {
    padding: 30rpx;
  }
  
  .order-card {
    background: #fff;
    border-radius: 28rpx;
    padding: 36rpx;
    margin-bottom: 30rpx;
    box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.02);
    animation: slideUp 0.4s ease-out;
  }
  
  @keyframes slideUp {
    from { opacity: 0;
    transform: translateY(30rpx); }
    to { opacity: 1; transform: translateY(0);
    }
  }
  
  /* --- 卡片头部 --- */
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 24rpx;
    border-bottom: 1rpx solid #F8FAFC;
    margin-bottom: 24rpx;
    height: 40rpx;
  }
  
  .header-left {
    display: flex;
    align-items: center;
  }
  
  /* 倒计时图标 */
  .icon-time {
    font-size: 28rpx;
    margin-right: 8rpx;
  }
  
  /* 倒计时数字 (红色高亮) */
  .countdown-highlight {
    font-size: 28rpx;
    color: #fa5151;
    font-weight: bold;
    font-family: Arial, sans-serif;
    margin-right: 8rpx;
    letter-spacing: 1rpx;
  }
  
  .countdown-label {
    font-size: 24rpx;
    color: #999;
  }
  
  /* 普通时间 */
  .order-time {
    font-size: 26rpx;
    color: #94A3B8;
    font-family: Arial, sans-serif;
    letter-spacing: 1rpx;
  }
  
  /* 状态文本 */
  .status-text {
    font-size: 28rpx;
    font-weight: 600;
  }
  
  /* --- 卡片中部 (商品) --- */
  .single-item {
    display: flex;
    align-items: center;
  }
  
  .goods-img {
    width: 150rpx;
    height: 150rpx;
    border-radius: 16rpx;
    background-color: #f8fafc;
    margin-right: 28rpx;
    flex-shrink: 0;
    border: 1rpx solid #f1f5f9;
  }
  
  .goods-info {
    flex: 1;
    height: 150rpx;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 4rpx 0;
  }
  
  .goods-name {
    font-size: 30rpx;
    color: #1e293b;
    line-height: 1.5;
    font-weight: 500;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .goods-qty {
    font-size: 26rpx;
    color: #94A3B8;
    background: #F1F5F9;
    padding: 2rpx 12rpx;
    border-radius: 8rpx;
    align-self: flex-start;
  }
  
  /* 多商品横滑 */
  .goods-scroll {
    width: 100%;
    white-space: nowrap;
  }
  
  .goods-img-small {
    width: 140rpx;
    height: 140rpx;
    border-radius: 16rpx;
    background-color: #f8fafc;
    margin-right: 20rpx;
    display: inline-block;
    border: 1rpx solid #f1f5f9;
  }
  
  .no-goods-tip {
    font-size: 26rpx;
    color: #ccc;
  }
  
  /* --- 卡片底部 (价格+按钮) --- */
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 28rpx;
    padding-top: 28rpx;
    border-top: 1rpx solid #F8FAFC;
  }
  
  .price-row {
    display: flex;
    align-items: baseline;
  }
  
  .count-text {
    font-size: 24rpx;
    color: #94A3B8;
    margin-right: 20rpx;
  }
  
  .total-label {
    font-size: 24rpx;
    color: #64748B;
    margin-right: 6rpx;
  }
  
  .currency {
    font-size: 26rpx;
    color: #1e293b;
    font-weight: bold;
  }
  
  .total-price {
    font-size: 40rpx;
    color: #1e293b;
    font-weight: 800;
    font-family: Arial, sans-serif;
    position: relative;
    top: 2rpx;
  }
  
  /* 按钮组 */
  .btn-row {
    display: flex;
    justify-content: flex-end; /* 靠右对齐 */
    gap: 20rpx; /* 增加按钮间距 */
  }
  
  .btn-action {
    margin: 0;
    padding: 0 40rpx;
    height: 68rpx;
    line-height: 68rpx;
    font-size: 28rpx;
    border-radius: 34rpx;
    font-weight: 500;
    box-sizing: border-box;
  }
  
  /* 默认按钮 */
  .btn-action.default {
    background: #fff;
    border: 1rpx solid #CBD5E1;
    color: #475569;
  }
  
  /* 绿色去支付按钮 */
  .btn-action.pay-btn {
    background: linear-gradient(135deg, #07c160, #05a955);
    border: none;
    color: #fff;
    box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.25);
  }
  
  /* 专属的去评价按钮样式 */
  .btn-action.review-btn {
    background: #fff;
    border: 1rpx solid #fa9d3b;
    color: #fa9d3b;
  }
  
  .btn-action:active {
    transform: scale(0.96);
  }
  
  /* =================================
     3. 空状态
     ================================= */
  .empty-state {
    padding-top: 240rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .empty-img {
    width: 240rpx;
    height: 240rpx;
    opacity: 0.5;
    margin-bottom: 24rpx;
  }
  
  .empty-text {
    font-size: 28rpx;
    color: #94A3B8;
  }
  
  /* =================================
     4. 支付弹窗样式 (半屏)
     ================================= */
  .pay-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0,0,0,0.6);
    z-index: 999;
    visibility: hidden;
    opacity: 0;
    transition: all 0.3s;
  }
  
  .pay-mask.show {
    visibility: visible;
    opacity: 1;
  }
  
  .pay-panel {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background: #fff;
    border-radius: 30rpx 30rpx 0 0;
    padding: 40rpx 40rpx 60rpx;
    box-sizing: border-box;
    transform: translateY(100%);
    transition: transform 0.3s;
  }
  
  .pay-mask.show .pay-panel {
    transform: translateY(0);
  }
  
  .panel-header {
    display: flex;
    justify-content: center;
    position: relative;
    margin-bottom: 40rpx;
  }
  
  .panel-title {
    font-size: 34rpx;
    font-weight: bold;
    color: #333;
  }
  
  .close-icon {
    position: absolute;
    right: 0;
    top: -10rpx;
    font-size: 44rpx;
    color: #999;
    padding: 10rpx;
  }
  
  .price-area {
    text-align: center;
    margin-bottom: 60rpx;
  }
  
  .currency {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
  }
  
  .amount {
    font-size: 72rpx;
    font-weight: 800;
    color: #333;
    font-family: Arial;
  }
  
  .method-row {
    display: flex;
    justify-content: space-between;
    font-size: 30rpx;
    color: #666;
    padding: 30rpx 0;
    border-top: 1rpx solid #f5f5f5;
    border-bottom: 1rpx solid #f5f5f5;
    margin-bottom: 50rpx;
  }
  
  .method-val {
    display: flex;
    align-items: center;
    color: #333;
  }
  
  .wx-icon {
    margin-right: 10rpx;
    font-size: 32rpx;
  }
  
  .confirm-pay-btn {
    width: 100%;
    height: 90rpx;
    line-height: 90rpx;
    background: #07c160;
    color: #fff;
    font-size: 34rpx;
    font-weight: bold;
    border-radius: 12rpx;
  }
  
  .confirm-pay-btn:active {
    background: #06ad56;
  }