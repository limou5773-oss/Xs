page {
    background: #f7f8fa;
    padding: 20rpx;
    box-sizing: border-box;
  }
  
  .card {
    background: #fff;
    border-radius: 20rpx;
    padding: 30rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
  }
  
  .title {
    font-size: 30rpx;
    font-weight: bold;
    margin-bottom: 24rpx;
    color: #333;
  }
  
  .type-box {
    display: flex;
    gap: 20rpx;
  }
  
  .type-item {
    padding: 16rpx 30rpx;
    border-radius: 12rpx;
    font-size: 28rpx;
    color: #666;
    background: #f5f7fa;
    border: 2rpx solid transparent;
    transition: all 0.2s;
  }
  
  .type-item.active {
    color: #07c160;
    background: #e8f8f0;
    border-color: #07c160;
    font-weight: 500;
  }
  
  .input-area {
    width: 100%;
    height: 200rpx;
    font-size: 28rpx;
    color: #333;
    line-height: 1.5;
  }
  
  .ph-style {
    color: #ccc;
  }
  
  .word-count {
    text-align: right;
    font-size: 24rpx;
    color: #ccc;
    margin-top: 10rpx;
  }
  
  .footer {
    margin-top: 60rpx;
    padding: 0 20rpx;
  }
  
  .submit-btn {
    width: 100%;
    height: 88rpx;
    line-height: 88rpx;
    background: linear-gradient(135deg, #ff9900, #ff5500);
    color: #fff;
    border-radius: 44rpx;
    font-size: 32rpx;
    font-weight: bold;
    box-shadow: 0 8rpx 16rpx rgba(255, 85, 0, 0.25);
  }
  
  .submit-btn:active {
    opacity: 0.9;
    transform: scale(0.98);
  }
  