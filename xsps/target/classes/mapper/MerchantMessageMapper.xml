<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sxps.xsps.mapper.MerchantMessageMapper">

    <select id="page" resultType="com.sxps.xsps.pojo.Message">
        SELECT *
        FROM message
        WHERE receiver_id = #{receiverId}

        <if test="p.keyword != null and p.keyword != ''">
            AND content LIKE CONCAT('%', #{p.keyword}, '%')
        </if>

        <if test="p.startTime != null and p.startTime != ''">
            AND create_time &gt;= #{p.startTime}
        </if>

        <if test="p.endTime != null and p.endTime != ''">
            AND create_time &lt;= #{p.endTime}
        </if>

        ORDER BY create_time DESC
    </select>

</mapper>
